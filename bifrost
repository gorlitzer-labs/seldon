# ── Main ──────────────────────────────────────────────────────────

case "${1:-}" in
  setup)       mode_setup ;;
  doctor)      mode_doctor ;;
  device)      shift; mode_device "$@" ;;
  status)      mode_status ;;
  attach)      shift; mode_attach "$@" ;;
  run)         shift; mode_run "$@" ;;
  mobile)      mode_mobile ;;
  direct)      mode_direct ;;
  workspace)   mode_workspace ;;
  kill)        mode_kill ;;
  help|--help) mode_help ;;
  *)
    mode_help
    exit 1
    ;;
esac
