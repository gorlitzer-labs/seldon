}

# ── Main ──────────────────────────────────────────────────────────

case "${1:-}" in
  setup)       mode_setup ;;
  doctor)      mode_doctor ;;
  status)      mode_status ;;
  attach)      shift; mode_attach "$@" ;;
  run)         shift; mode_run "$@" ;;
  mobile)      mode_mobile ;;
  direct)      mode_direct ;;
  workspace)   mode_workspace ;;
  kill)        mode_kill ;;
  help|--help) mode_help ;;
  *)
    echo "Usage: bifrost <command> — run 'bifrost help' for details"
    echo ""
    echo "  setup      — configure remote hostname and SSH user"
    echo "  doctor     — check prerequisites (tmux, iTerm2, Tailscale, SSH)"
    echo "  status     — show active sessions and remote connectivity"
    echo "  attach     — attach to a session (e.g. bifrost attach remote-2)"
    echo "  run        — run a command on the remote (e.g. bifrost run uptime)"
    echo ""
    echo "  workspace  — 2x2 grid on both machines (macOS + iTerm2)"
    echo "  mobile     — tmux sessions (reattach from phone)"
    echo "  direct     — iTerm split panes with direct SSH"
    echo "  kill       — tear down all tmux sessions"
    exit 1
    ;;
esac
