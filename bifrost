#!/usr/bin/env bash
# bifrost — dual-machine iTerm2 workspace launcher
#
# Usage: bifrost <command>  — run 'bifrost help' for details
#
# Commands: setup, status, attach, run, workspace, mobile, direct, kill
#
# Config: ~/.config/bifrost/config (created by 'bifrost setup')

set -euo pipefail

# ── Platform detection ───────────────────────────────────────────
# macOS + iTerm2: full workspace/split support
# Termux/Linux:   attach, status, run, kill (no iTerm)
if [[ -d "/data/data/com.termux" ]]; then
  BIFROST_PLATFORM="termux"
elif [[ "$(uname)" == "Darwin" ]]; then
  BIFROST_PLATFORM="macos"
else
  BIFROST_PLATFORM="linux"
fi

# ── Config ────────────────────────────────────────────────────────
BIFROST_CONFIG="${HOME}/.config/bifrost/config"

load_config() {
  if [[ -f "$BIFROST_CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$BIFROST_CONFIG"
  fi
}

save_config() {
  mkdir -p "$(dirname "$BIFROST_CONFIG")"
  cat > "$BIFROST_CONFIG" <<CFG
# Bifrost configuration — generated by 'bifrost setup'
BIFROST_REMOTE_HOST="$REMOTE_HOST"
BIFROST_REMOTE_USER="$REMOTE_USER"
CFG
  echo "Config saved to $BIFROST_CONFIG"
}

mode_setup() {
  echo "Bifrost setup"
  echo ""

  # Remote hostname
  local default_host="${REMOTE_HOST:-}"
  if [[ -n "$default_host" ]]; then
    read -rp "Remote hostname (Tailscale) [$default_host]: " input_host
    REMOTE_HOST="${input_host:-$default_host}"
  else
    read -rp "Remote hostname (Tailscale): " REMOTE_HOST
    if [[ -z "$REMOTE_HOST" ]]; then
      echo "Error: hostname is required."
      exit 1
    fi
  fi

  # Remote user
  local default_user="${REMOTE_USER:-$(whoami)}"
  read -rp "SSH user on remote [$default_user]: " input_user
  REMOTE_USER="${input_user:-$default_user}"

  # Test connection
  echo ""
  echo "Testing SSH to $REMOTE_USER@$REMOTE_HOST..."
  if ssh -o ConnectTimeout=5 "$REMOTE_USER@$REMOTE_HOST" "echo 'Connected to $(hostname)'" 2>/dev/null; then
    echo "Connection OK."
  else
    echo "Warning: could not reach $REMOTE_HOST — config saved anyway."
  fi

  save_config
}

# Load saved config, then allow env var overrides
load_config
REMOTE_HOST="${WORKBENCH_REMOTE:-${BIFROST_REMOTE_HOST:-}}"
REMOTE_USER="${WORKBENCH_USER:-${BIFROST_REMOTE_USER:-$(whoami)}}"
LOCAL_SESSION="${WORKBENCH_LOCAL_SESSION:-local}"
REMOTE_SESSION="${WORKBENCH_REMOTE_SESSION:-remote}"

# Require REMOTE_HOST for modes that need it
require_remote() {
  if [[ -z "$REMOTE_HOST" ]]; then
    echo "No remote host configured. Run 'bifrost setup' first."
    exit 1
  fi
}

require_iterm() {
  if [[ "$BIFROST_PLATFORM" != "macos" ]]; then
    echo "Error: '$1' mode requires macOS + iTerm2."
    echo ""
    echo "On Termux/Linux, use:"
    echo "  bifrost attach <session>   — attach to a tmux session"
    echo "  bifrost status             — check sessions and connectivity"
    echo "  bifrost run <cmd>          — run a command on remote"
    exit 1
  fi
}

# ── Doctor (prereq check) ───────────────────────────────────────

mode_doctor() {
  echo "Bifrost doctor"
  echo ""
  local ok=true

  # ── Local checks ──
  echo "  LOCAL ($BIFROST_PLATFORM):"

  # tmux
  if command -v tmux &>/dev/null; then
    echo "    ✓ tmux $(tmux -V 2>/dev/null | awk '{print $2}')"
  else
    echo "    ✗ tmux — not installed"
    case "$BIFROST_PLATFORM" in
      macos)  echo "      → brew install tmux" ;;
      termux) echo "      → pkg install tmux" ;;
      linux)  echo "      → sudo apt install tmux  (or your package manager)" ;;
    esac
    ok=false
  fi

  # SSH
  if command -v ssh &>/dev/null; then
    echo "    ✓ ssh"
  else
    echo "    ✗ ssh — not installed"
    case "$BIFROST_PLATFORM" in
      termux) echo "      → pkg install openssh" ;;
      *)      echo "      → should be pre-installed — check your system" ;;
    esac
    ok=false
  fi

  # iTerm2 (macOS only)
  if [[ "$BIFROST_PLATFORM" == "macos" ]]; then
    if [[ -d "/Applications/iTerm.app" ]]; then
      echo "    ✓ iTerm2"
    else
      echo "    ✗ iTerm2 — not installed"
      echo "      → brew install --cask iterm2"
      echo "      → or download from https://iterm2.com"
      ok=false
    fi
  fi

  # Tailscale
  if command -v tailscale &>/dev/null; then
    local ts_status
    ts_status=$(tailscale status --json 2>/dev/null | grep -o '"BackendState":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    if [[ "$ts_status" == "Running" ]]; then
      echo "    ✓ Tailscale (running)"
    else
      echo "    ⚠ Tailscale (installed but status: $ts_status)"
      echo "      → tailscale up"
      ok=false
    fi
  elif [[ "$BIFROST_PLATFORM" == "macos" && -d "/Applications/Tailscale.app" ]]; then
    echo "    ⚠ Tailscale (app installed, CLI not in PATH)"
    echo "      → open Tailscale from Applications"
  else
    echo "    ✗ Tailscale — not installed"
    case "$BIFROST_PLATFORM" in
      macos)  echo "      → brew install --cask tailscale" ;;
      termux) echo "      → see https://tailscale.com/kb/1169/android" ;;
      linux)  echo "      → curl -fsSL https://tailscale.com/install.sh | sh" ;;
    esac
    ok=false
  fi

  # Config
  if [[ -f "$BIFROST_CONFIG" ]]; then
    echo "    ✓ Config ($BIFROST_CONFIG)"
  else
    echo "    ⚠ No config — run 'bifrost setup'"
  fi

  echo ""

  # ── Remote checks ──
  if [[ -n "$REMOTE_HOST" ]]; then
    echo "  REMOTE ($REMOTE_HOST):"

    if ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_USER@$REMOTE_HOST" "echo ok" &>/dev/null; then
      echo "    ✓ SSH connection"

      # Check remote tmux
      local remote_tmux
      remote_tmux=$(ssh -o ConnectTimeout=3 "$REMOTE_USER@$REMOTE_HOST" "tmux -V 2>/dev/null || echo 'missing'" 2>/dev/null)
      if [[ "$remote_tmux" == "missing" ]]; then
        echo "    ✗ tmux — not installed on remote"
        echo "      → ssh $REMOTE_USER@$REMOTE_HOST 'brew install tmux'"
        ok=false
      else
        echo "    ✓ $remote_tmux"
      fi
    else
      echo "    ✗ SSH connection failed"
      echo "      → check Tailscale is running on both machines"
      echo "      → verify: ssh $REMOTE_USER@$REMOTE_HOST"
      ok=false
    fi
  else
    echo "  REMOTE: not configured — run 'bifrost setup'"
  fi

  echo ""
  if [[ "$ok" == true ]]; then
    echo "  All good. Ready to bifrost."
  else
    echo "  Some issues found. Fix them and run 'bifrost doctor' again."
  fi
}

# ── Device management ────────────────────────────────────────────
BIFROST_DEVICES_DIR="${HOME}/.config/bifrost/devices"

# Background tint colors per device (r/g/b hex for iTerm)
DEVICE_COLORS=(
  "28/0a/0a"   # dark red
  "0a/0a/28"   # dark blue
  "0a/28/0a"   # dark green
  "28/1e/0a"   # dark amber
  "1e/0a/28"   # dark purple
  "0a/28/28"   # dark teal
)

get_device_color() {
  local idx=$1
  echo "${DEVICE_COLORS[$((idx % ${#DEVICE_COLORS[@]}))]}"
}

list_devices() {
  # Returns device names (filenames in devices dir)
  if [[ -d "$BIFROST_DEVICES_DIR" ]]; then
    ls "$BIFROST_DEVICES_DIR" 2>/dev/null
  fi
}

load_device() {
  # Load a device config by name. Sets DEVICE_HOST and DEVICE_USER.
  local name="$1"
  local file="$BIFROST_DEVICES_DIR/$name"
  if [[ ! -f "$file" ]]; then
    echo "Error: device '$name' not found. Run 'bifrost device list'."
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$file"
}

mode_device() {
  local subcmd="${1:-}"
  case "$subcmd" in
    add)
      shift
      device_add "$@"
      ;;
    remove|rm)
      shift
      device_remove "$@"
      ;;
    list|ls)
      device_list
      ;;
    scan)
      device_scan
      ;;
    *)
      echo "Usage: bifrost device <add|remove|list|scan>"
      echo ""
      echo "  add <name>     — add a device (interactive or from Tailscale)"
      echo "  remove <name>  — remove a device"
      echo "  list           — show configured devices"
      echo "  scan           — discover devices on your Tailscale network"
      exit 1
      ;;
  esac
}

device_scan() {
  echo "Scanning Tailscale network..."
  echo ""

  if ! command -v tailscale &>/dev/null; then
    echo "Error: tailscale CLI not found."
    exit 1
  fi

  local this_host
  this_host=$(tailscale status --json 2>/dev/null | grep -o '"Self":{"ID":"[^"]*","HostName":"[^"]*"' | grep -o '"HostName":"[^"]*"' | cut -d'"' -f4 || hostname -s)

  local existing
  existing=$(list_devices)

  echo "  Devices on your tailnet:"
  echo ""

  tailscale status 2>/dev/null | while read -r line; do
    # Skip header and empty lines
    [[ "$line" == *"#"* ]] && continue
    [[ -z "$line" ]] && continue

    local ip host user os
    ip=$(echo "$line" | awk '{print $1}')
    host=$(echo "$line" | awk '{print $2}')
    os=$(echo "$line" | awk '{print $NF}')

    # Skip this machine
    if [[ "$host" == "$this_host" ]]; then
      echo "    $host ($os) ← this machine"
      continue
    fi

    # Check if already added
    if echo "$existing" | grep -qx "$host" 2>/dev/null; then
      echo "    ✓ $host ($os) — already added"
    else
      echo "    ○ $host ($os) — not added (bifrost device add $host)"
    fi
  done
}

device_add() {
  local name="${1:-}"
  mkdir -p "$BIFROST_DEVICES_DIR"

  if [[ -z "$name" ]]; then
    echo "Usage: bifrost device add <name>"
    echo ""
    echo "Tip: run 'bifrost device scan' to see available Tailscale devices."
    exit 1
  fi

  # Check if already exists
  if [[ -f "$BIFROST_DEVICES_DIR/$name" ]]; then
    echo "Device '$name' already configured. Remove first: bifrost device remove $name"
    exit 1
  fi

  # Try to detect from Tailscale
  local ts_host=""
  if command -v tailscale &>/dev/null; then
    ts_host=$(tailscale status 2>/dev/null | awk -v h="$name" '$2 == h {print $2}')
  fi

  local host user
  if [[ -n "$ts_host" ]]; then
    echo "Found '$name' on Tailscale."
    host="$name"
  else
    read -rp "Hostname or IP for '$name': " host
    if [[ -z "$host" ]]; then
      echo "Error: hostname is required."
      exit 1
    fi
  fi

  local default_user
  default_user=$(whoami)
  read -rp "SSH user [$default_user]: " user
  user="${user:-$default_user}"

  # Test connection
  echo ""
  echo "Testing SSH to $user@$host..."
  if ssh -o ConnectTimeout=5 "$user@$host" "echo 'OK — \$(uname -m)'" 2>/dev/null; then
    echo "Connected."

    # Check if key-based auth works (needed for non-interactive commands)
    if ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$user@$host" "true" 2>/dev/null; then
      echo ""
      echo "⚠ Password auth works, but key-based auth is not set up."
      echo "  Bifrost needs key auth for non-interactive commands (status, run, etc)."
      echo ""
      read -rp "Copy SSH key to $host now? [Y/n]: " copy_key
      if [[ "${copy_key:-Y}" =~ ^[Yy]$ ]]; then
        # Ensure key exists
        if [[ ! -f "$HOME/.ssh/id_ed25519.pub" && ! -f "$HOME/.ssh/id_rsa.pub" ]]; then
          echo "  No SSH key found. Generating one..."
          ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N "" -q
          echo "  Key generated: ~/.ssh/id_ed25519"
        fi
        ssh-copy-id "$user@$host" 2>/dev/null
        echo "  Key copied. Testing..."
        if ssh -o ConnectTimeout=5 -o BatchMode=yes "$user@$host" "true" 2>/dev/null; then
          echo "  ✓ Key auth working."
        else
          echo "  ✗ Key auth still failing — check ~/.ssh/authorized_keys on $host"
        fi
      fi
    else
      echo "  ✓ Key auth working."
    fi
  else
    echo "Warning: could not connect — saved anyway."
    echo "  Make sure the device is online and SSH is enabled."
  fi

  cat > "$BIFROST_DEVICES_DIR/$name" <<CFG
DEVICE_HOST="$host"
DEVICE_USER="$user"
CFG

  echo "Device '$name' added."
  echo ""
  device_list
}

device_remove() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: bifrost device remove <name>"
    exit 1
  fi
  if [[ -f "$BIFROST_DEVICES_DIR/$name" ]]; then
    rm "$BIFROST_DEVICES_DIR/$name"
    echo "Device '$name' removed."
  else
    echo "Device '$name' not found."
  fi
}

device_list() {
  echo "Configured devices:"
  echo ""
  local devices
  devices=$(list_devices)
  if [[ -z "$devices" ]]; then
    echo "  (none) — run 'bifrost device add <name>' or 'bifrost device scan'"
    return
  fi
  local idx=0
  for name in $devices; do
    source "$BIFROST_DEVICES_DIR/$name"
    local color
    color=$(get_device_color $idx)
    local status="?"
    if ssh -o ConnectTimeout=2 -o BatchMode=yes "$DEVICE_USER@$DEVICE_HOST" "true" &>/dev/null; then
      status="✓ online"
    elif ssh -o ConnectTimeout=2 "$DEVICE_USER@$DEVICE_HOST" "true" &>/dev/null; then
      status="⚠ online (needs key auth)"
    else
      status="✗ offline"
    fi
    echo "  $status $name → $DEVICE_USER@$DEVICE_HOST (bg: $color)"
    idx=$((idx + 1))
  done
}

# Migrate old single-remote config to device if needed
migrate_legacy_config() {
  if [[ -f "$BIFROST_CONFIG" && ! -d "$BIFROST_DEVICES_DIR" ]]; then
    source "$BIFROST_CONFIG"
    if [[ -n "${BIFROST_REMOTE_HOST:-}" ]]; then
      mkdir -p "$BIFROST_DEVICES_DIR"
      cat > "$BIFROST_DEVICES_DIR/$BIFROST_REMOTE_HOST" <<CFG
DEVICE_HOST="$BIFROST_REMOTE_HOST"
DEVICE_USER="${BIFROST_REMOTE_USER:-$(whoami)}"
CFG
      echo "Migrated legacy config → device '$BIFROST_REMOTE_HOST'"
    fi
  fi
}
migrate_legacy_config

# Colors — ANSI 24-bit escape sequences for iTerm2
# Local:  dark background (default)
# Remote: dark red tint so you never forget where you are
LOCAL_BG="0;0;0"          # black
REMOTE_BG="40;10;10"      # dark red tint

# ── Helpers ───────────────────────────────────────────────────────

set_iterm_bg() {
  # Set iTerm2 background color via proprietary escape
  local r=$1 g=$2 b=$3
  printf "\033]1337;SetColors=bg=%02x/%02x/%02x\007" "$r" "$g" "$b"
}

iterm_set_tab_title() {
  printf "\033]1;%s\007" "$1"
}

ensure_tmux_session() {
  local host="$1" session="$2"
  if [[ "$host" == "local" ]]; then
    tmux has-session -t "$session" 2>/dev/null || tmux new-session -d -s "$session"
  else
    ssh -o ConnectTimeout=5 "$REMOTE_USER@$host" \
      "tmux has-session -t '$session' 2>/dev/null || tmux new-session -d -s '$session'"
  fi
}

# SSH command with auto-reconnect loop for remote panes
# When connection drops (reboot, network blip), retries every 5s until back
ssh_reconnect_cmd() {
  local user="$1" host="$2" session="$3"
  # This runs inside the iTerm pane as a shell command
  echo "while true; do echo '🌈 Connecting to $host ($session)...'; ssh -t -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 $user@$host 'tmux attach -t $session || tmux new-session -s $session'; echo '🔌 Connection lost. Reconnecting in 5s...'; sleep 5; done"
}

# ── Mode: mobile (tmux) ──────────────────────────────────────────
#
# Creates persistent tmux sessions on both machines.
# You can reattach from Blink Shell on your phone:
#   local:  ssh legendary → tmux attach -t local
#   remote: ssh zanpakuto → tmux attach -t remote

mode_mobile() {
  require_iterm "mobile"
  echo "Setting up mobile-ready tmux bifrost..."

  # Ensure local tmux session exists
  ensure_tmux_session "local" "$LOCAL_SESSION"

  if [[ -n "$REMOTE_HOST" ]]; then
    ensure_tmux_session "$REMOTE_HOST" "$REMOTE_SESSION"

    osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  set newWindow to (create window with default profile)
  tell current session of current tab of newWindow
    set name to "LOCAL [$LOCAL_SESSION]"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t $LOCAL_SESSION"
  end tell
  tell newWindow
    set remoteTab to (create tab with default profile)
    tell current session of remoteTab
      set name to "REMOTE [$REMOTE_SESSION] @ $REMOTE_HOST"
      write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "$REMOTE_SESSION")"
    end tell
  end tell
end tell
APPLESCRIPT

    echo ""
    echo "Bifrost ready (mobile mode)"
    echo "  Tab 1: LOCAL  → tmux session '$LOCAL_SESSION'"
    echo "  Tab 2: REMOTE → tmux session '$REMOTE_SESSION' @ $REMOTE_HOST"
  else
    osascript <<APPLESCRIPT
tell application "iTerm2"
  activate
  set newWindow to (create window with default profile)
  tell current session of current tab of newWindow
    set name to "LOCAL [$LOCAL_SESSION]"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t $LOCAL_SESSION"
  end tell
end tell
APPLESCRIPT

    echo ""
    echo "Bifrost ready (mobile mode — local only)"
    echo "  Tab 1: LOCAL → tmux session '$LOCAL_SESSION'"
    echo ""
    echo "Add a remote: bifrost setup"
  fi
}

# ── Mode: direct (split panes) ───────────────────────────────────
#
# Single iTerm window with side-by-side splits.
# Left = local, Right = SSH into zanpakuto.
# No tmux — direct connection, visual color distinction.

mode_direct() {
  require_iterm "direct"
  require_remote
  echo "Setting up direct mac-to-mac bifrost..."

  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate

  set newWindow to (create window with default profile)

  tell current session of current tab of newWindow
    -- Left pane: local (default dark bg)
    set name to "LOCAL"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; clear"
    write text "echo '── LOCAL ($(hostname)) ──'"

    -- Split right for remote
    set remoteSession to (split horizontally with default profile)
  end tell

  tell remoteSession
    set name to "REMOTE @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; while true; do echo '🌈 Connecting to $REMOTE_HOST...'; ssh -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 $REMOTE_USER@$REMOTE_HOST; echo '🔌 Connection lost. Reconnecting in 5s...'; sleep 5; done"
  end tell
end tell
APPLESCRIPT

  echo ""
  echo "Workbench ready (direct mode)"
  echo "  Left:  LOCAL (default bg)"
  echo "  Right: REMOTE @ $REMOTE_HOST (red tint bg)"
}

# ── Emoji pool ───────────────────────────────────────────────────

EMOJIS=(
  "🐝" "🐛" "🦋" "🐞" "🪲" "🐜" "🦗" "🐌" "🐙" "🦑"
  "🦀" "🪱" "🦠" "🔬" "⚡" "🔥" "🌀" "💎" "🎯" "🚀"
  "🌊" "🍄" "🌵" "🎲" "🧊" "🪐" "🌙" "☄️" "🗡️" "🛡️"
)

pick_emoji() {
  # Random emoji from pool, avoiding recently used ones
  echo "${EMOJIS[$((RANDOM % ${#EMOJIS[@]}))]}"
}

# ── Mode: workspace (2x2 grid on both machines) ─────────────────
#
# Creates two iTerm windows, each with 4 panes (iTerm splits).
# Each pane runs its own tmux session: <prefix>-<n>
# Session title: <emoji> <folder_name>
# From phone: tmux attach -t local-1 (or remote-1, etc.)

create_pane_session() {
  # Create a single tmux session on a host
  # Args: host session_name emoji
  local host="$1" session="$2" emoji="$3"

  # tmux options: set pane title, enable title display
  local cmd="tmux kill-session -t '$session' 2>/dev/null; true; "
  cmd+="tmux new-session -d -s '$session'; "
  cmd+="tmux set-option -t '$session' set-titles on; "
  cmd+="tmux set-option -t '$session' pane-border-format ' $emoji $session '; "
  cmd+="tmux set-option -t '$session' status-left ' $emoji $session  '"

  if [[ "$host" == "local" ]]; then
    eval "$cmd"
  else
    ssh -o ConnectTimeout=5 "$REMOTE_USER@$host" "$cmd"
  fi
}

build_grid_applescript() {
  # Generates AppleScript for a 2x2 grid window
  # Args: bg_color e1 e2 e3 e4 cmd1 cmd2 cmd3 cmd4 label1 label2 label3 label4
  local bg="$1" e1="$2" e2="$3" e3="$4" e4="$5"
  local cmd1="$6" cmd2="$7" cmd3="$8" cmd4="$9"
  local l1="${10}" l2="${11}" l3="${12}" l4="${13}"

  cat <<APPLESCRIPT_GRID

  set gridWindow to (create window with default profile)

  tell current session of current tab of gridWindow
    set name to "$e1 $l1"
    write text "printf '\\\\033]1337;SetColors=bg=$bg\\\\007'; $cmd1"
    set p2 to (split horizontally with default profile)
  end tell

  tell p2
    set name to "$e2 $l2"
    write text "printf '\\\\033]1337;SetColors=bg=$bg\\\\007'; $cmd2"
  end tell

  tell current session of current tab of gridWindow
    set p3 to (split vertically with default profile)
  end tell

  tell p3
    set name to "$e3 $l3"
    write text "printf '\\\\033]1337;SetColors=bg=$bg\\\\007'; $cmd3"
  end tell

  tell p2
    set p4 to (split vertically with default profile)
  end tell

  tell p4
    set name to "$e4 $l4"
    write text "printf '\\\\033]1337;SetColors=bg=$bg\\\\007'; $cmd4"
  end tell
APPLESCRIPT_GRID
}

mode_workspace() {
  require_iterm "workspace"

  local devices
  devices=$(list_devices)

  echo "Setting up workspace..."

  # Pick emojis for local
  local e1 e2 e3 e4
  e1=$(pick_emoji) e2=$(pick_emoji) e3=$(pick_emoji) e4=$(pick_emoji)

  # Create local tmux sessions
  echo "  Creating local sessions..."
  create_pane_session "local" "${LOCAL_SESSION}-1" "$e1"
  create_pane_session "local" "${LOCAL_SESSION}-2" "$e2"
  create_pane_session "local" "${LOCAL_SESSION}-3" "$e3"
  create_pane_session "local" "${LOCAL_SESSION}-4" "$e4"

  # Start building AppleScript
  local applescript='tell application "iTerm2"
  activate
'
  # Local window
  applescript+=$(build_grid_applescript "00/00/00" \
    "$e1" "$e2" "$e3" "$e4" \
    "tmux attach -t ${LOCAL_SESSION}-1" \
    "tmux attach -t ${LOCAL_SESSION}-2" \
    "tmux attach -t ${LOCAL_SESSION}-3" \
    "tmux attach -t ${LOCAL_SESSION}-4" \
    "${LOCAL_SESSION}-1" "${LOCAL_SESSION}-2" "${LOCAL_SESSION}-3" "${LOCAL_SESSION}-4")

  echo ""
  echo "  LOCAL:"
  echo "    $e1 ${LOCAL_SESSION}-1    $e2 ${LOCAL_SESSION}-2"
  echo "    $e3 ${LOCAL_SESSION}-3    $e4 ${LOCAL_SESSION}-4"

  # One window per device
  local dev_idx=0
  for dev_name in $devices; do
    load_device "$dev_name"
    local bg
    bg=$(get_device_color $dev_idx)

    local de1 de2 de3 de4
    de1=$(pick_emoji) de2=$(pick_emoji) de3=$(pick_emoji) de4=$(pick_emoji)

    echo ""
    echo "  Creating sessions on $dev_name..."
    create_pane_session "$DEVICE_HOST" "${dev_name}-1" "$de1"
    create_pane_session "$DEVICE_HOST" "${dev_name}-2" "$de2"
    create_pane_session "$DEVICE_HOST" "${dev_name}-3" "$de3"
    create_pane_session "$DEVICE_HOST" "${dev_name}-4" "$de4"

    local rc1 rc2 rc3 rc4
    rc1=$(ssh_reconnect_cmd "$DEVICE_USER" "$DEVICE_HOST" "${dev_name}-1")
    rc2=$(ssh_reconnect_cmd "$DEVICE_USER" "$DEVICE_HOST" "${dev_name}-2")
    rc3=$(ssh_reconnect_cmd "$DEVICE_USER" "$DEVICE_HOST" "${dev_name}-3")
    rc4=$(ssh_reconnect_cmd "$DEVICE_USER" "$DEVICE_HOST" "${dev_name}-4")

    applescript+=$(build_grid_applescript "$bg" \
      "$de1" "$de2" "$de3" "$de4" \
      "$rc1" "$rc2" "$rc3" "$rc4" \
      "${dev_name}-1 @ $DEVICE_HOST" "${dev_name}-2 @ $DEVICE_HOST" \
      "${dev_name}-3 @ $DEVICE_HOST" "${dev_name}-4 @ $DEVICE_HOST")

    echo "  $dev_name @ $DEVICE_HOST (bg: $bg):"
    echo "    $de1 ${dev_name}-1    $de2 ${dev_name}-2"
    echo "    $de3 ${dev_name}-3    $de4 ${dev_name}-4"

    dev_idx=$((dev_idx + 1))
  done

  applescript+='
end tell'

  osascript -e "$applescript"

  echo ""
  if [[ -z "$devices" ]]; then
    echo "  Local only. Add devices: bifrost device add <name>"
  fi
  echo "Workspace ready."
}

# ── Mode: kill ────────────────────────────────────────────────────

mode_kill() {
  echo "Killing tmux sessions..."

  # Kill local sessions
  tmux kill-session -t "$LOCAL_SESSION" 2>/dev/null && echo "  Killed local '$LOCAL_SESSION'" || true
  for i in 1 2 3 4; do
    tmux kill-session -t "${LOCAL_SESSION}-$i" 2>/dev/null && echo "  Killed local '${LOCAL_SESSION}-$i'" || true
  done

  # Kill sessions on all configured devices
  local devices
  devices=$(list_devices)
  for dev_name in $devices; do
    load_device "$dev_name"
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$DEVICE_USER@$DEVICE_HOST" "
      for i in 1 2 3 4; do
        tmux kill-session -t '${dev_name}-'\$i 2>/dev/null && echo '  Killed ${dev_name}-'\$i || true
      done
    " 2>/dev/null || echo "  Could not reach $dev_name ($DEVICE_HOST)"
  done

  echo "Done."
}

# ── Mode: status ─────────────────────────────────────────────────

mode_status() {
  echo "Bifrost status"
  echo ""

  # Local sessions
  echo "  LOCAL:"
  local local_count=0
  local local_list=""
  for session in "$LOCAL_SESSION" "${LOCAL_SESSION}-1" "${LOCAL_SESSION}-2" "${LOCAL_SESSION}-3" "${LOCAL_SESSION}-4"; do
    if tmux has-session -t "$session" 2>/dev/null; then
      local_count=$((local_count + 1))
      local_list+="    ✓ $session"
      local cmd
      cmd=$(tmux list-panes -t "$session" -F '#{pane_current_command}' 2>/dev/null | head -1)
      [[ -n "$cmd" ]] && local_list+=" ($cmd)"
      local_list+=$'\n'
    fi
  done
  if [[ $local_count -gt 0 ]]; then
    echo "    $local_count session(s) active"
    printf "%s" "$local_list"
  else
    echo "    No active sessions"
  fi

  # Device sessions
  local devices
  devices=$(list_devices)
  for dev_name in $devices; do
    echo ""
    load_device "$dev_name"
    echo "  $dev_name ($DEVICE_HOST):"
    if ssh -o ConnectTimeout=3 -o BatchMode=yes "$DEVICE_USER@$DEVICE_HOST" "echo ok" &>/dev/null; then
      echo "    ✓ Reachable"
      local remote_info
      remote_info=$(ssh -o ConnectTimeout=3 "$DEVICE_USER@$DEVICE_HOST" "
        for i in 1 2 3 4; do
          s='${dev_name}-'\$i
          if tmux has-session -t \"\$s\" 2>/dev/null; then
            cmd=\$(tmux list-panes -t \"\$s\" -F '#{pane_current_command}' 2>/dev/null | head -1)
            echo \"    ✓ \$s (\$cmd)\"
          fi
        done
      " 2>/dev/null)
      if [[ -n "$remote_info" ]]; then
        echo "$remote_info"
      else
        echo "    No active sessions"
      fi
    else
      echo "    ✗ Unreachable"
    fi
  done

  if [[ -z "$devices" ]]; then
    echo ""
    echo "  No devices configured. Run 'bifrost device add <name>'."
  fi
}

# ── Mode: attach ─────────────────────────────────────────────────

mode_attach() {
  local session="${1:-}"
  if [[ -z "$session" ]]; then
    echo "Usage: bifrost attach <session-name>"
    echo ""
    echo "Examples:"
    echo "  bifrost attach local-1"
    echo "  bifrost attach mydevice-2"
    echo ""
    echo "Local sessions:"
    tmux list-sessions -F "  #{session_name}" 2>/dev/null || echo "  (none)"
    local devices
    devices=$(list_devices)
    for dev_name in $devices; do
      load_device "$dev_name"
      echo ""
      echo "$dev_name ($DEVICE_HOST):"
      ssh -o ConnectTimeout=3 -o BatchMode=yes "$DEVICE_USER@$DEVICE_HOST" \
        "tmux list-sessions -F '  #{session_name}' 2>/dev/null || echo '  (none)'" 2>/dev/null \
        || echo "  (unreachable)"
    done
    exit 1
  fi

  # Extract device name from session (e.g. "mydevice-2" → "mydevice")
  local dev_name="${session%-[0-9]*}"

  # Check if it's a local session
  if [[ "$dev_name" == "$LOCAL_SESSION" || "$dev_name" == "$session" ]]; then
    echo "Attaching to $session..."
    tmux attach -t "$session" || echo "Session $session not found"
    return
  fi

  # Check if it matches a device
  if [[ -f "$BIFROST_DEVICES_DIR/$dev_name" ]]; then
    load_device "$dev_name"
    echo "Attaching to $session @ $DEVICE_HOST..."
    ssh -t "$DEVICE_USER@$DEVICE_HOST" "tmux attach -t '$session' || echo 'Session $session not found'"
  else
    # Try local first, then fail
    echo "Attaching to $session..."
    tmux attach -t "$session" || echo "Session '$session' not found. Run 'bifrost device list' to see devices."
  fi
}

# ── Mode: run ────────────────────────────────────────────────────

mode_run() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: bifrost run <device> <command>"
    echo ""
    echo "Runs a command on a device via SSH."
    echo ""
    echo "Examples:"
    echo "  bifrost run mydevice uptime"
    echo "  bifrost run mydevice df -h"
    echo "  bifrost run mydevice docker ps"
    exit 1
  fi

  local dev_name="$1"
  shift

  if [[ $# -lt 1 ]]; then
    echo "Usage: bifrost run $dev_name <command>"
    exit 1
  fi

  if [[ ! -f "$BIFROST_DEVICES_DIR/$dev_name" ]]; then
    echo "Device '$dev_name' not found. Run 'bifrost device list'."
    exit 1
  fi

  load_device "$dev_name"
  ssh -o ConnectTimeout=5 "$DEVICE_USER@$DEVICE_HOST" "$*"
}

