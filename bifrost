#!/usr/bin/env bash
# bifrost — dual-machine iTerm2 workspace launcher
#
# Usage: bifrost <command>  — run 'bifrost help' for details
#
# Commands: setup, status, attach, run, workspace, mobile, direct, kill
#
# Config: ~/.config/bifrost/config (created by 'bifrost setup')

set -euo pipefail

# ── Platform detection ───────────────────────────────────────────
# macOS + iTerm2: full workspace/split support
# Termux/Linux:   attach, status, run, kill (no iTerm)
if [[ -d "/data/data/com.termux" ]]; then
  BIFROST_PLATFORM="termux"
elif [[ "$(uname)" == "Darwin" ]]; then
  BIFROST_PLATFORM="macos"
else
  BIFROST_PLATFORM="linux"
fi

# ── Config ────────────────────────────────────────────────────────
BIFROST_CONFIG="${HOME}/.config/bifrost/config"

load_config() {
  if [[ -f "$BIFROST_CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$BIFROST_CONFIG"
  fi
}

save_config() {
  mkdir -p "$(dirname "$BIFROST_CONFIG")"
  cat > "$BIFROST_CONFIG" <<CFG
# Bifrost configuration — generated by 'bifrost setup'
BIFROST_REMOTE_HOST="$REMOTE_HOST"
BIFROST_REMOTE_USER="$REMOTE_USER"
CFG
  echo "Config saved to $BIFROST_CONFIG"
}

mode_setup() {
  echo "Bifrost setup"
  echo ""

  # Remote hostname
  local default_host="${REMOTE_HOST:-}"
  if [[ -n "$default_host" ]]; then
    read -rp "Remote hostname (Tailscale) [$default_host]: " input_host
    REMOTE_HOST="${input_host:-$default_host}"
  else
    read -rp "Remote hostname (Tailscale): " REMOTE_HOST
    if [[ -z "$REMOTE_HOST" ]]; then
      echo "Error: hostname is required."
      exit 1
    fi
  fi

  # Remote user
  local default_user="${REMOTE_USER:-$(whoami)}"
  read -rp "SSH user on remote [$default_user]: " input_user
  REMOTE_USER="${input_user:-$default_user}"

  # Test connection
  echo ""
  echo "Testing SSH to $REMOTE_USER@$REMOTE_HOST..."
  if ssh -o ConnectTimeout=5 "$REMOTE_USER@$REMOTE_HOST" "echo 'Connected to $(hostname)'" 2>/dev/null; then
    echo "Connection OK."
  else
    echo "Warning: could not reach $REMOTE_HOST — config saved anyway."
  fi

  save_config
}

# Load saved config, then allow env var overrides
load_config
REMOTE_HOST="${WORKBENCH_REMOTE:-${BIFROST_REMOTE_HOST:-}}"
REMOTE_USER="${WORKBENCH_USER:-${BIFROST_REMOTE_USER:-$(whoami)}}"
LOCAL_SESSION="${WORKBENCH_LOCAL_SESSION:-local}"
REMOTE_SESSION="${WORKBENCH_REMOTE_SESSION:-remote}"

# Require REMOTE_HOST for modes that need it
require_remote() {
  if [[ -z "$REMOTE_HOST" ]]; then
    echo "No remote host configured. Run 'bifrost setup' first."
    exit 1
  fi
}

require_iterm() {
  if [[ "$BIFROST_PLATFORM" != "macos" ]]; then
    echo "Error: '$1' mode requires macOS + iTerm2."
    echo ""
    echo "On Termux/Linux, use:"
    echo "  bifrost attach <session>   — attach to a tmux session"
    echo "  bifrost status             — check sessions and connectivity"
    echo "  bifrost run <cmd>          — run a command on remote"
    exit 1
  fi
}

# ── Doctor (prereq check) ───────────────────────────────────────

mode_doctor() {
  echo "Bifrost doctor"
  echo ""
  local ok=true

  # ── Local checks ──
  echo "  LOCAL ($BIFROST_PLATFORM):"

  # tmux
  if command -v tmux &>/dev/null; then
    echo "    ✓ tmux $(tmux -V 2>/dev/null | awk '{print $2}')"
  else
    echo "    ✗ tmux — not installed"
    case "$BIFROST_PLATFORM" in
      macos)  echo "      → brew install tmux" ;;
      termux) echo "      → pkg install tmux" ;;
      linux)  echo "      → sudo apt install tmux  (or your package manager)" ;;
    esac
    ok=false
  fi

  # SSH
  if command -v ssh &>/dev/null; then
    echo "    ✓ ssh"
  else
    echo "    ✗ ssh — not installed"
    case "$BIFROST_PLATFORM" in
      termux) echo "      → pkg install openssh" ;;
      *)      echo "      → should be pre-installed — check your system" ;;
    esac
    ok=false
  fi

  # iTerm2 (macOS only)
  if [[ "$BIFROST_PLATFORM" == "macos" ]]; then
    if [[ -d "/Applications/iTerm.app" ]]; then
      echo "    ✓ iTerm2"
    else
      echo "    ✗ iTerm2 — not installed"
      echo "      → brew install --cask iterm2"
      echo "      → or download from https://iterm2.com"
      ok=false
    fi
  fi

  # Tailscale
  if command -v tailscale &>/dev/null; then
    local ts_status
    ts_status=$(tailscale status --json 2>/dev/null | grep -o '"BackendState":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    if [[ "$ts_status" == "Running" ]]; then
      echo "    ✓ Tailscale (running)"
    else
      echo "    ⚠ Tailscale (installed but status: $ts_status)"
      echo "      → tailscale up"
      ok=false
    fi
  elif [[ "$BIFROST_PLATFORM" == "macos" && -d "/Applications/Tailscale.app" ]]; then
    echo "    ⚠ Tailscale (app installed, CLI not in PATH)"
    echo "      → open Tailscale from Applications"
  else
    echo "    ✗ Tailscale — not installed"
    case "$BIFROST_PLATFORM" in
      macos)  echo "      → brew install --cask tailscale" ;;
      termux) echo "      → see https://tailscale.com/kb/1169/android" ;;
      linux)  echo "      → curl -fsSL https://tailscale.com/install.sh | sh" ;;
    esac
    ok=false
  fi

  # Config
  if [[ -f "$BIFROST_CONFIG" ]]; then
    echo "    ✓ Config ($BIFROST_CONFIG)"
  else
    echo "    ⚠ No config — run 'bifrost setup'"
  fi

  echo ""

  # ── Remote checks ──
  if [[ -n "$REMOTE_HOST" ]]; then
    echo "  REMOTE ($REMOTE_HOST):"

    if ssh -o ConnectTimeout=3 -o BatchMode=yes "$REMOTE_USER@$REMOTE_HOST" "echo ok" &>/dev/null; then
      echo "    ✓ SSH connection"

      # Check remote tmux
      local remote_tmux
      remote_tmux=$(ssh -o ConnectTimeout=3 "$REMOTE_USER@$REMOTE_HOST" "tmux -V 2>/dev/null || echo 'missing'" 2>/dev/null)
      if [[ "$remote_tmux" == "missing" ]]; then
        echo "    ✗ tmux — not installed on remote"
        echo "      → ssh $REMOTE_USER@$REMOTE_HOST 'brew install tmux'"
        ok=false
      else
        echo "    ✓ $remote_tmux"
      fi
    else
      echo "    ✗ SSH connection failed"
      echo "      → check Tailscale is running on both machines"
      echo "      → verify: ssh $REMOTE_USER@$REMOTE_HOST"
      ok=false
    fi
  else
    echo "  REMOTE: not configured — run 'bifrost setup'"
  fi

  echo ""
  if [[ "$ok" == true ]]; then
    echo "  All good. Ready to bifrost."
  else
    echo "  Some issues found. Fix them and run 'bifrost doctor' again."
  fi
}

# Colors — ANSI 24-bit escape sequences for iTerm2
# Local:  dark background (default)
# Remote: dark red tint so you never forget where you are
LOCAL_BG="0;0;0"          # black
REMOTE_BG="40;10;10"      # dark red tint

# ── Helpers ───────────────────────────────────────────────────────

set_iterm_bg() {
  # Set iTerm2 background color via proprietary escape
  local r=$1 g=$2 b=$3
  printf "\033]1337;SetColors=bg=%02x/%02x/%02x\007" "$r" "$g" "$b"
}

iterm_set_tab_title() {
  printf "\033]1;%s\007" "$1"
}

ensure_tmux_session() {
  local host="$1" session="$2"
  if [[ "$host" == "local" ]]; then
    tmux has-session -t "$session" 2>/dev/null || tmux new-session -d -s "$session"
  else
    ssh -o ConnectTimeout=5 "$REMOTE_USER@$host" \
      "tmux has-session -t '$session' 2>/dev/null || tmux new-session -d -s '$session'"
  fi
}

# SSH command with auto-reconnect loop for remote panes
# When connection drops (reboot, network blip), retries every 5s until back
ssh_reconnect_cmd() {
  local user="$1" host="$2" session="$3"
  # This runs inside the iTerm pane as a shell command
  echo "while true; do echo '🌈 Connecting to $host ($session)...'; ssh -t -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 $user@$host 'tmux attach -t $session || tmux new-session -s $session'; echo '🔌 Connection lost. Reconnecting in 5s...'; sleep 5; done"
}

# ── Mode: mobile (tmux) ──────────────────────────────────────────
#
# Creates persistent tmux sessions on both machines.
# You can reattach from Blink Shell on your phone:
#   local:  ssh legendary → tmux attach -t local
#   remote: ssh zanpakuto → tmux attach -t remote

mode_mobile() {
  require_iterm "mobile"
  require_remote
  echo "Setting up mobile-ready tmux bifrost..."

  # Ensure tmux sessions exist
  ensure_tmux_session "local" "$LOCAL_SESSION"
  ensure_tmux_session "$REMOTE_HOST" "$REMOTE_SESSION"

  # Launch iTerm2 with two tabs via AppleScript
  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate

  -- Create new window with local tmux tab
  set newWindow to (create window with default profile)

  tell current session of current tab of newWindow
    set name to "LOCAL [$LOCAL_SESSION]"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t $LOCAL_SESSION"
  end tell

  -- Create second tab with remote tmux
  tell newWindow
    set remoteTab to (create tab with default profile)
    tell current session of remoteTab
      set name to "REMOTE [$REMOTE_SESSION] @ $REMOTE_HOST"
      write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "$REMOTE_SESSION")"
    end tell
  end tell
end tell
APPLESCRIPT

  echo ""
  echo "Workbench ready (mobile mode)"
  echo "  Tab 1: LOCAL  → tmux session '$LOCAL_SESSION'"
  echo "  Tab 2: REMOTE → tmux session '$REMOTE_SESSION' @ $REMOTE_HOST"
  echo ""
  echo "From your phone (Blink Shell):"
  echo "  Local:  ssh legendary → tmux attach -t $LOCAL_SESSION"
  echo "  Remote: ssh $REMOTE_HOST → tmux attach -t $REMOTE_SESSION"
}

# ── Mode: direct (split panes) ───────────────────────────────────
#
# Single iTerm window with side-by-side splits.
# Left = local, Right = SSH into zanpakuto.
# No tmux — direct connection, visual color distinction.

mode_direct() {
  require_iterm "direct"
  require_remote
  echo "Setting up direct mac-to-mac bifrost..."

  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate

  set newWindow to (create window with default profile)

  tell current session of current tab of newWindow
    -- Left pane: local (default dark bg)
    set name to "LOCAL"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; clear"
    write text "echo '── LOCAL ($(hostname)) ──'"

    -- Split right for remote
    set remoteSession to (split horizontally with default profile)
  end tell

  tell remoteSession
    set name to "REMOTE @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; while true; do echo '🌈 Connecting to $REMOTE_HOST...'; ssh -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 $REMOTE_USER@$REMOTE_HOST; echo '🔌 Connection lost. Reconnecting in 5s...'; sleep 5; done"
  end tell
end tell
APPLESCRIPT

  echo ""
  echo "Workbench ready (direct mode)"
  echo "  Left:  LOCAL (default bg)"
  echo "  Right: REMOTE @ $REMOTE_HOST (red tint bg)"
}

# ── Emoji pool ───────────────────────────────────────────────────

EMOJIS=(
  "🐝" "🐛" "🦋" "🐞" "🪲" "🐜" "🦗" "🐌" "🐙" "🦑"
  "🦀" "🪱" "🦠" "🔬" "⚡" "🔥" "🌀" "💎" "🎯" "🚀"
  "🌊" "🍄" "🌵" "🎲" "🧊" "🪐" "🌙" "☄️" "🗡️" "🛡️"
)

pick_emoji() {
  # Random emoji from pool, avoiding recently used ones
  echo "${EMOJIS[$((RANDOM % ${#EMOJIS[@]}))]}"
}

# ── Mode: workspace (2x2 grid on both machines) ─────────────────
#
# Creates two iTerm windows, each with 4 panes (iTerm splits).
# Each pane runs its own tmux session: <prefix>-<n>
# Session title: <emoji> <folder_name>
# From phone: tmux attach -t local-1 (or remote-1, etc.)

create_pane_session() {
  # Create a single tmux session on a host
  # Args: host session_name emoji
  local host="$1" session="$2" emoji="$3"

  # tmux options: set pane title, enable title display
  local cmd="tmux kill-session -t '$session' 2>/dev/null; true; "
  cmd+="tmux new-session -d -s '$session'; "
  cmd+="tmux set-option -t '$session' set-titles on; "
  cmd+="tmux set-option -t '$session' pane-border-format ' $emoji $session '; "
  cmd+="tmux set-option -t '$session' status-left ' $emoji $session  '"

  if [[ "$host" == "local" ]]; then
    eval "$cmd"
  else
    ssh -o ConnectTimeout=5 "$REMOTE_USER@$host" "$cmd"
  fi
}

mode_workspace() {
  require_iterm "workspace"
  require_remote
  echo "Setting up workspace (2x2 grid on both machines)..."

  # Pick 8 unique-ish emojis (4 local + 4 remote)
  local e1 e2 e3 e4 e5 e6 e7 e8
  e1=$(pick_emoji) e2=$(pick_emoji) e3=$(pick_emoji) e4=$(pick_emoji)
  e5=$(pick_emoji) e6=$(pick_emoji) e7=$(pick_emoji) e8=$(pick_emoji)

  # Create 4 tmux sessions per machine
  echo "  Creating local sessions..."
  create_pane_session "local" "${LOCAL_SESSION}-1" "$e1"
  create_pane_session "local" "${LOCAL_SESSION}-2" "$e2"
  create_pane_session "local" "${LOCAL_SESSION}-3" "$e3"
  create_pane_session "local" "${LOCAL_SESSION}-4" "$e4"

  echo "  Creating remote sessions on $REMOTE_HOST..."
  create_pane_session "$REMOTE_HOST" "${REMOTE_SESSION}-1" "$e5"
  create_pane_session "$REMOTE_HOST" "${REMOTE_SESSION}-2" "$e6"
  create_pane_session "$REMOTE_HOST" "${REMOTE_SESSION}-3" "$e7"
  create_pane_session "$REMOTE_HOST" "${REMOTE_SESSION}-4" "$e8"

  osascript <<APPLESCRIPT
tell application "iTerm2"
  activate

  -- ═══ Window 1: LOCAL ═══
  set localWindow to (create window with default profile)

  tell current session of current tab of localWindow
    set name to "$e1 ${LOCAL_SESSION}-1"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t ${LOCAL_SESSION}-1"

    -- Split right (pane 2)
    set p2 to (split horizontally with default profile)
  end tell

  tell p2
    set name to "$e2 ${LOCAL_SESSION}-2"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t ${LOCAL_SESSION}-2"
  end tell

  -- Now split each column vertically
  tell current session of current tab of localWindow
    set p3 to (split vertically with default profile)
  end tell

  tell p3
    set name to "$e3 ${LOCAL_SESSION}-3"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t ${LOCAL_SESSION}-3"
  end tell

  tell p2
    set p4 to (split vertically with default profile)
  end tell

  tell p4
    set name to "$e4 ${LOCAL_SESSION}-4"
    write text "printf '\\\\033]1337;SetColors=bg=00/00/00\\\\007'; tmux attach -t ${LOCAL_SESSION}-4"
  end tell

  -- ═══ Window 2: REMOTE (zanpakuto) ═══
  set remoteWindow to (create window with default profile)

  tell current session of current tab of remoteWindow
    set name to "$e5 ${REMOTE_SESSION}-1 @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "${REMOTE_SESSION}-1")"

    set r2 to (split horizontally with default profile)
  end tell

  tell r2
    set name to "$e6 ${REMOTE_SESSION}-2 @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "${REMOTE_SESSION}-2")"
  end tell

  tell current session of current tab of remoteWindow
    set r3 to (split vertically with default profile)
  end tell

  tell r3
    set name to "$e7 ${REMOTE_SESSION}-3 @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "${REMOTE_SESSION}-3")"
  end tell

  tell r2
    set r4 to (split vertically with default profile)
  end tell

  tell r4
    set name to "$e8 ${REMOTE_SESSION}-4 @ $REMOTE_HOST"
    write text "printf '\\\\033]1337;SetColors=bg=28/0a/0a\\\\007'; $(ssh_reconnect_cmd "$REMOTE_USER" "$REMOTE_HOST" "${REMOTE_SESSION}-4")"
  end tell

end tell
APPLESCRIPT

  echo ""
  echo "Workspace ready"
  echo ""
  echo "  LOCAL:"
  echo "    $e1 ${LOCAL_SESSION}-1    $e2 ${LOCAL_SESSION}-2"
  echo "    $e3 ${LOCAL_SESSION}-3    $e4 ${LOCAL_SESSION}-4"
  echo ""
  echo "  REMOTE @ $REMOTE_HOST:"
  echo "    $e5 ${REMOTE_SESSION}-1    $e6 ${REMOTE_SESSION}-2"
  echo "    $e7 ${REMOTE_SESSION}-3    $e8 ${REMOTE_SESSION}-4"
  echo ""
  echo "From phone:"
  echo "  ssh legendary → tmux attach -t ${LOCAL_SESSION}-1"
  echo "  ssh $REMOTE_HOST → tmux attach -t ${REMOTE_SESSION}-1"
}

# ── Mode: kill ────────────────────────────────────────────────────

mode_kill() {
  echo "Killing tmux sessions..."

  # Kill single sessions (mobile mode)
  tmux kill-session -t "$LOCAL_SESSION" 2>/dev/null && echo "  Killed local '$LOCAL_SESSION'" || true

  # Kill workspace sessions (local-1..4)
  for i in 1 2 3 4; do
    tmux kill-session -t "${LOCAL_SESSION}-$i" 2>/dev/null && echo "  Killed local '${LOCAL_SESSION}-$i'" || true
  done

  # Kill remote sessions
  ssh -o ConnectTimeout=5 "$REMOTE_USER@$REMOTE_HOST" "
    tmux kill-session -t '$REMOTE_SESSION' 2>/dev/null && echo '  Killed remote $REMOTE_SESSION' || true
    for i in 1 2 3 4; do
      tmux kill-session -t '${REMOTE_SESSION}-'\$i 2>/dev/null && echo '  Killed remote ${REMOTE_SESSION}-'\$i || true
    done
  " || echo "  Could not reach $REMOTE_HOST"

  echo "Done."
}

# ── Mode: status ─────────────────────────────────────────────────

mode_status() {
  echo "Bifrost status"
  echo ""

  # Local sessions
  echo "  LOCAL:"
  local local_count=0
  local local_list=""
  for session in "$LOCAL_SESSION" "${LOCAL_SESSION}-1" "${LOCAL_SESSION}-2" "${LOCAL_SESSION}-3" "${LOCAL_SESSION}-4"; do
    if tmux has-session -t "$session" 2>/dev/null; then
      local_count=$((local_count + 1))
      local_list+="    ✓ $session"
      # Get what's running in the session
      local cmd
      cmd=$(tmux list-panes -t "$session" -F '#{pane_current_command}' 2>/dev/null | head -1)
      [[ -n "$cmd" ]] && local_list+=" ($cmd)"
      local_list+=$'\n'
    fi
  done
  if [[ $local_count -gt 0 ]]; then
    echo "    $local_count session(s) active"
    printf "%s" "$local_list"
  else
    echo "    No active sessions"
  fi

  echo ""

  # Remote
  echo "  REMOTE ($REMOTE_HOST):"
  if [[ -z "$REMOTE_HOST" ]]; then
    echo "    Not configured — run 'bifrost setup'"
  elif ssh -o ConnectTimeout=3 "$REMOTE_USER@$REMOTE_HOST" "echo ok" &>/dev/null; then
    echo "    ✓ Reachable"
    local remote_info
    remote_info=$(ssh -o ConnectTimeout=3 "$REMOTE_USER@$REMOTE_HOST" "
      for s in $REMOTE_SESSION ${REMOTE_SESSION}-1 ${REMOTE_SESSION}-2 ${REMOTE_SESSION}-3 ${REMOTE_SESSION}-4; do
        if tmux has-session -t \"\$s\" 2>/dev/null; then
          cmd=\$(tmux list-panes -t \"\$s\" -F '#{pane_current_command}' 2>/dev/null | head -1)
          echo \"    ✓ \$s (\$cmd)\"
        fi
      done
    " 2>/dev/null)
    if [[ -n "$remote_info" ]]; then
      local remote_count
      remote_count=$(echo "$remote_info" | wc -l | tr -d ' ')
      echo "    $remote_count session(s) active"
      echo "$remote_info"
    else
      echo "    No active sessions"
    fi
  else
    echo "    ✗ Unreachable"
  fi
}

# ── Mode: attach ─────────────────────────────────────────────────

mode_attach() {
  local session="${1:-}"
  if [[ -z "$session" ]]; then
    echo "Usage: bifrost attach <session-name>"
    echo ""
    echo "Examples:"
    echo "  bifrost attach local-1"
    echo "  bifrost attach remote-2"
    echo ""
    # List available sessions
    echo "Local sessions:"
    tmux list-sessions -F "  #{session_name}" 2>/dev/null || echo "  (none)"
    if [[ -n "$REMOTE_HOST" ]]; then
      echo ""
      echo "Remote sessions ($REMOTE_HOST):"
      ssh -o ConnectTimeout=3 "$REMOTE_USER@$REMOTE_HOST" \
        "tmux list-sessions -F '  #{session_name}' 2>/dev/null || echo '  (none)'" 2>/dev/null \
        || echo "  (unreachable)"
    fi
    exit 1
  fi

  # Check if it's a remote session
  if [[ "$session" == remote* ]]; then
    require_remote
    echo "Attaching to $session @ $REMOTE_HOST..."
    ssh -t "$REMOTE_USER@$REMOTE_HOST" "tmux attach -t '$session' || echo 'Session $session not found'"
  else
    echo "Attaching to $session..."
    tmux attach -t "$session" || echo "Session $session not found"
  fi
}

# ── Mode: run ────────────────────────────────────────────────────

mode_run() {
  local cmd="${*}"
  if [[ -z "$cmd" ]]; then
    echo "Usage: bifrost run <command>"
    echo ""
    echo "Runs a command on the remote machine via SSH."
    echo ""
    echo "Examples:"
    echo "  bifrost run df -h"
    echo "  bifrost run docker ps"
    echo "  bifrost run uptime"
    exit 1
  fi

  require_remote
  ssh -o ConnectTimeout=5 "$REMOTE_USER@$REMOTE_HOST" "$cmd"
}

