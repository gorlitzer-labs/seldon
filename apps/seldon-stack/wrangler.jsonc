{
  // seldon-stack as a Cloudflare Worker serving the Vite build as static assets.
  // No Worker script — assets-only. `npm run build` first, then `wrangler deploy`.
  "name": "seldon-stack",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    // SPA: unknown paths fall back to index.html (harmless even with hash routing).
    "not_found_handling": "single-page-application"
  },
  // Serve at the canonical host (a specific custom domain overrides the
  // *.gorlitzerpark.com wildcard tunnel that used to point at the homelab).
  "routes": [
    { "pattern": "seldon.gorlitzerpark.com", "custom_domain": true }
  ]
}
